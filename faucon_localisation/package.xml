<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>faucon_localisation</name>
  <version>0.0.0</version>
  <description>Localization package using dual EKF for GPS/IMU sensor fusion on the Faucon agricultural robot</description>
  <maintainer email="kleinfy51@gmail.com">klein</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>python3-utm</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
