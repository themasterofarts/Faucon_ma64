<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">

    <xacro:arg name="use_ros2_control" default="true"/>
    <!-- <xacro:arg name="type_leg_joint" defaut="revolute"/> -->

    <!-- Articulations de braquage des jambes : pilotees (revolute) avec ros2_control,
         bloquees (fixed) avec le DiffDrive Gazebo, qui n'a aucun controleur pour elles. -->
    <xacro:property name="steer_joint_type"
                    value="${'revolute' if '$(arg use_ros2_control)'.lower() == 'true' else 'fixed'}"/>

    <xacro:include filename="robot_core_control.xacro" />
    
    <xacro:include filename="lidar.xacro" />
   
    <xacro:include filename="camera.xacro" />
    <xacro:include filename="imu.xacro" />
    <xacro:include filename="gps.xacro" />
    <xacro:include filename="odom.xacro" />
    
    <!-- <xacro:include filename="gazebo_control.xacro" /> -->
    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="ros2_control.xacro" />
    </xacro:if>
    <xacro:unless value="$(arg use_ros2_control)">
        <xacro:include filename="gazebo_control.xacro" />
    </xacro:unless>




</robot>