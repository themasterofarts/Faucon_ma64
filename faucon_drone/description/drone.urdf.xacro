<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="drone">

  <!--
    Faucon Drone — Quadrotor URDF
    X-frame configuration, 1.5 kg class.

    Sensors:
      - Downward RGB camera  (field mapping / UGV guidance from above)
      - NavSat GPS           (position in WGS-84)
      - IMU                  (attitude + angular rate)

    Public ROS topics:
      /faucon/drone/cmd_vel      ← geometry_msgs/Twist  (velocity command)
      /faucon/drone/arm          ← std_msgs/Bool         (motor enable)
      /faucon/drone/gps          → sensor_msgs/NavSatFix
      /faucon/drone/imu          → sensor_msgs/Imu
      /faucon/drone/camera/image → sensor_msgs/Image
      /faucon/drone/odom         → nav_msgs/Odometry

    Internal Gazebo topics remain under "drone/" and are bridged in config.

    TF frames (all prefixed drone_):
      drone_base_link
      ├── drone_rotor_{0-3}
      ├── drone_camera_link / drone_camera_optical
      ├── drone_gnss_frame
      └── drone_imu_link
  -->

  <xacro:include filename="drone_body.xacro"/>
  <xacro:include filename="drone_camera.xacro"/>
  <xacro:include filename="drone_gps.xacro"/>
  <xacro:include filename="drone_imu.xacro"/>
  <xacro:include filename="drone_plugins.xacro"/>

</robot>
