<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Downward-looking RGB camera (nadir view).
    Primary use: aerial field mapping and UGV row guidance from above.

    Mounted at the bottom of the drone body, lens pointing down (−Z).
    The optical frame follows the ROS convention: Z forward, X right, Y down.

    Published Gazebo topic: drone/camera (bridged via ros_gz_image)
    ROS topic: /faucon/drone/camera/image  (sensor_msgs/Image)
              /faucon/drone/camera/camera_info (sensor_msgs/CameraInfo)
  -->

  <joint name="drone_camera_joint" type="fixed">
    <parent link="drone_base_link"/>
    <child  link="drone_camera_link"/>
    <!-- Bottom-center of body, pitched down 90° so lens faces −Z -->
    <origin xyz="0 0 -0.04" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="drone_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.025"/></geometry>
      <material name="cam_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- Optical frame: ROS convention (Z forward = camera optical axis) -->
  <joint name="drone_camera_optical_joint" type="fixed">
    <parent link="drone_camera_link"/>
    <child  link="drone_camera_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="drone_camera_optical"/>

  <!-- Gazebo sensor definition -->
  <gazebo reference="drone_camera_link">
    <sensor name="drone_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <camera>
        <!-- 60° horizontal FOV — good trade-off between coverage and resolution -->
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>200.0</far>
        </clip>
      </camera>
      <topic>drone/camera</topic>
      <gz_frame_id>drone_camera_optical</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
