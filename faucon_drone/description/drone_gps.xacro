<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    NavSat GPS sensor.
    Mounted on top of the drone body.

    Gazebo topic: drone/gnss/fix  (gz.msgs.NavSat)
    ROS topic:    /faucon/drone/gps (sensor_msgs/NavSatFix)

    Coordinates use the world spherical_coordinates origin defined in the
    world SDF (lat=43.9°, lon=3.2°, ENU frame).
  -->

  <joint name="drone_gnss_joint" type="fixed">
    <parent link="drone_base_link"/>
    <child  link="drone_gnss_frame"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="drone_gnss_frame">
    <visual>
      <geometry><cylinder radius="0.012" length="0.010"/></geometry>
      <material name="gps_white"><color rgba="0.9 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <gazebo reference="drone_gnss_frame">
    <sensor name="drone_gnss" type="navsat">
      <pose>0 0 0 0 0 0</pose>
      <topic>drone/gnss/fix</topic>
      <gz_frame_id>drone_gnss_frame</gz_frame_id>
      <update_rate>5</update_rate>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0003</stddev>
            </noise>
          </vertical>
        </position_sensing>
        <velocity_sensing>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </velocity_sensing>
      </navsat>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
