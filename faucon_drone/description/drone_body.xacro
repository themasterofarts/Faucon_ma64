<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- === Dimensions & mass === -->
  <xacro:property name="arm_length"  value="0.20"/>
  <xacro:property name="rotor_xy"    value="0.141"/>  <!-- arm_length * cos(45°) -->
  <xacro:property name="rotor_z"     value="0.015"/>  <!-- slightly above body center -->
  <xacro:property name="body_mass"   value="1.5"/>
  <xacro:property name="rotor_mass"  value="0.005"/>

  <!-- === Base body (central hub + 4 arms as visuals) === -->
  <link name="drone_base_link">

    <!-- Central hub -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.06"/></geometry>
      <material name="drone_body">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>

    <!-- Arm 0 : center → front-left  (NW, +x +y, 45°) -->
    <visual>
      <origin xyz="${rotor_xy/2} ${rotor_xy/2} 0" rpy="0 0 ${pi/4}"/>
      <geometry><box size="${arm_length * 1.414} 0.018 0.018"/></geometry>
      <material name="drone_arm"><color rgba="0.20 0.20 0.20 1.0"/></material>
    </visual>
    <!-- Arm 1 : center → front-right (NE, +x -y, -45°) -->
    <visual>
      <origin xyz="${rotor_xy/2} ${-rotor_xy/2} 0" rpy="0 0 ${-pi/4}"/>
      <geometry><box size="${arm_length * 1.414} 0.018 0.018"/></geometry>
      <material name="drone_arm"/>
    </visual>
    <!-- Arm 2 : center → back-left   (SW, -x +y, 135°) -->
    <visual>
      <origin xyz="${-rotor_xy/2} ${rotor_xy/2} 0" rpy="0 0 ${3*pi/4}"/>
      <geometry><box size="${arm_length * 1.414} 0.018 0.018"/></geometry>
      <material name="drone_arm"/>
    </visual>
    <!-- Arm 3 : center → back-right  (SE, -x -y, -135°) -->
    <visual>
      <origin xyz="${-rotor_xy/2} ${-rotor_xy/2} 0" rpy="0 0 ${-3*pi/4}"/>
      <geometry><box size="${arm_length * 1.414} 0.018 0.018"/></geometry>
      <material name="drone_arm"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.06"/></geometry>
    </collision>

    <inertial>
      <mass value="${body_mass}"/>
      <!-- Empirically validated inertia for a 1.5 kg quadrotor (Gazebo X3 class) -->
      <inertia ixx="0.029125" ixy="0" ixz="0"
               iyy="0.029125" iyz="0"
               izz="0.055225"/>
    </inertial>
  </link>

  <!-- === Rotor macro (continuous joint, thin disc) === -->
  <xacro:macro name="rotor" params="id x y z color_rgba">
    <joint name="drone_rotor_${id}_joint" type="continuous">
      <parent link="drone_base_link"/>
      <child  link="drone_rotor_${id}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis   xyz="0 0 1"/>
      <limit  effort="1000" velocity="838"/>
      <dynamics damping="0.004" friction="0.0"/>
    </joint>

    <link name="drone_rotor_${id}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.128" length="0.005"/></geometry>
        <material name="rotor_mat_${id}">
          <color rgba="${color_rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.128" length="0.005"/></geometry>
      </collision>
      <inertial>
        <mass value="${rotor_mass}"/>
        <inertia ixx="1.75e-5" ixy="0" ixz="0"
                 iyy="1.75e-5" iyz="0"
                 izz="3.50e-5"/>
      </inertial>
    </link>
  </xacro:macro>

  <!--
    X-frame motor layout (viewed from above):
        0(CCW,blue)   1(CW,red)
              \   ^   /
               \ | /
        2(CW,red)   3(CCW,blue)
    CCW rotors on diagonals → torque balance at hover.
  -->
  <xacro:rotor id="0" x="${rotor_xy}"  y="${rotor_xy}"  z="${rotor_z}" color_rgba="0.1 0.1 0.9 1.0"/>
  <xacro:rotor id="1" x="${rotor_xy}"  y="${-rotor_xy}" z="${rotor_z}" color_rgba="0.9 0.1 0.1 1.0"/>
  <xacro:rotor id="2" x="${-rotor_xy}" y="${rotor_xy}"  z="${rotor_z}" color_rgba="0.9 0.1 0.1 1.0"/>
  <xacro:rotor id="3" x="${-rotor_xy}" y="${-rotor_xy}" z="${rotor_z}" color_rgba="0.1 0.1 0.9 1.0"/>

</robot>
