<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.015" length="0.03"/></geometry>
      <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <!-- Ajout des ixy, ixz, iyz -->
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/>
    <origin xyz="0.1 0 0.08" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat"> <!-- 'navsat' -->
      <update_rate>10</update_rate>
      <topic>/drone/gps</topic>
      <!-- LA BALISE PLUGIN A ÉTÉ SUPPRIMÉE ICI -->
    </sensor>
  </gazebo>
</robot>