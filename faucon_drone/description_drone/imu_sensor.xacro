<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="silver"><color rgba="0.8 0.8 0.8 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <!-- Ajout des ixy, ixz, iyz -->
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <update_rate>200</update_rate><always_on>true</always_on><visualize>true</visualize>

      <topic>/drone/imu</topic> <!-- le topic -->
      <imu>
        <noise type="gaussian">
          <rate><mean>0.0</mean><stddev>0.0002</stddev></rate>
          <accel><mean>0.0</mean><stddev>0.002</stddev></accel>
        </noise>
      </imu>
      
    </sensor>
  </gazebo>
</robot>